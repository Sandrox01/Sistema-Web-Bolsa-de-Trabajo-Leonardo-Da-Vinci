# =========================
# CONFIGURACIÓN DEL SERVIDOR
# =========================
# Para uso LOCAL (solo en tu PC):
HOST=localhost
PORT=5500
PUBLIC_BASE_URL=http://localhost:5500

# Para uso en RED o SERVIDOR (acceso desde otras PCs):
# HOST=0.0.0.0
# PORT=5500
# PUBLIC_BASE_URL=http://[IP-del-servidor]:5500
# (Descomenta estas líneas y pon la IP real del servidor cuando lo subas)

# =========================
# CONFIGURACIÓN DE BASE DE DATOS (MySQL)
# =========================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bolsa_trabajo_ldv